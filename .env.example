APP_NAME=control-io-api
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/control_io
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=control_io

# Uploads
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=15

# Auth
API_KEY_HEADER=X-API-Key
API_KEY=dev-key-change-me

# AI Provider (local by default - set accordingly)
AI_PROVIDER=local
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma4:12b
AI_API_KEY=none
AI_TEMPERATURE=0.0
AI_TIMEOUT_SECONDS=300
AI_MAX_RETRIES=2

# Extracción confiable
AI_MAX_PASSES=2
AI_NUM_CTX=8192
AI_NUM_PREDICT=2048
AI_MIN_NAME_SIMILARITY=85
AI_USE_SECTION_CROPS=true
AI_TARGET_CROP_WIDTH=1800
AI_SECOND_PASS_WIDTH=2400
AI_ENHANCE_SECOND_PASS=true
AI_USE_ROW_CROPS=true
AI_SIGNATURE_INK_THRESHOLD=0.02

# Confidence threshold
CONFIDENCE_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
